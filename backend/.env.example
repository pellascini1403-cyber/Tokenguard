# TokenGuard backend environment configuration
# Copy this file to .env and adjust values for your local setup.
# Do NOT commit a real .env file.

# --- Server (implemented in Step 1) ---

# Port the HTTP server listens on.
PORT=3000

# Host/interface the HTTP server binds to.
HOST=0.0.0.0

# Runtime environment: development | test | production
NODE_ENV=development

# --- Supabase (implemented in Step 2) ---
# Without these, the server falls back to local-development placeholder
# values that point at the Supabase CLI's local stack and cannot
# authenticate against a real project. In production these are required.

# Supabase project URL. Not secret — the same value a browser client uses.
SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/public key. Constrained by Row Level Security; safe to ship
# to a browser client. Used here only to validate user access tokens.
SUPABASE_ANON_KEY=

# Supabase service role key. Bypasses Row Level Security entirely.
# SERVER-ONLY. Never send this to a browser, log it, or embed it in
# frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider proxy (implemented in Step 4) ---
# Provider API keys are never configured here: OpenAI/Anthropic credentials
# arrive per-request from the client (Authorization for OpenAI, x-api-key
# for Anthropic) and TokenGuard never persists, logs, or returns them.

# Upstream base URL for OpenAI-compatible requests. Not secret. Override
# for local development/tests (e.g. pointing at a fake upstream server).
OPENAI_BASE_URL=https://api.openai.com

# Upstream base URL for Anthropic requests. Not secret.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# How long the proxy waits for an upstream provider response before
# aborting the request, in milliseconds.
PROVIDER_REQUEST_TIMEOUT_MS=30000

# Maximum accepted request body size for proxy endpoints, in bytes.
MAX_PROXY_BODY_BYTES=5242880

# --- Streaming (implemented in Step 6) ---
# `stream: true` requests are relayed live via SSE. PROVIDER_REQUEST_TIMEOUT_MS
# above still bounds how long we wait for the provider to start responding;
# this separately bounds the total time a stream may stay open once it has
# started, regardless of how many chunks keep arriving — a single stream
# trickling data forever would otherwise never time out.

# Hard ceiling on the total duration of a single streaming response, in
# milliseconds, once streaming has begun. Default: 300000 (5 minutes), long
# enough for a large generation while still bounding a stalled/runaway
# upstream stream.
STREAM_MAX_DURATION_MS=300000

# --- Agent loop detection (implemented in Step 7) ---
# Detects rapid repetition of effectively identical requests — same
# organization, same TokenGuard key, same provider/endpoint/model, same
# normalized request body — within a short window, and temporarily
# blocks that exact repeated request (429) before it ever reaches the
# provider. Conservative by design: it never blocks merely because the
# same model or endpoint is reused, only genuinely repeated requests.
# In-memory and process-local — see README's "Agent loop detection"
# section for what that means with multiple proxy instances.

# Fixed window, in milliseconds, over which identical requests are
# counted.
AGENT_LOOP_WINDOW_MS=10000

# Maximum number of identical requests allowed within the window before
# the next one is treated as a loop and blocked.
AGENT_LOOP_THRESHOLD=5

# How long a detected signature stays blocked once the threshold is
# exceeded, in milliseconds.
AGENT_LOOP_BLOCK_DURATION_MS=30000

# Maximum number of distinct request signatures tracked in memory at
# once. Bounds memory use — oldest entries are evicted first once this
# is reached.
AGENT_LOOP_MAX_ENTRIES=10000

# --- Async usage logging (implemented in Step 9) ---
# token_logs persistence runs on a small in-process queue/worker instead
# of blocking the client response — see README's "Async usage logging"
# section for exactly what stays synchronous (Step 8 budget accounting)
# versus what's deferred (the token_logs audit row), and its limitations
# (in-process only, not a durable distributed queue).

# Maximum number of usage events queued but not yet persisted. Bounds
# memory use — once full, a new event is not queued (never a fake $0
# charge, never a crash); it's logged as a high-severity
# USAGE_LOG_QUEUE_FULL event instead.
USAGE_LOG_QUEUE_MAX_SIZE=5000

# Number of usage events persisted concurrently by the background worker.
USAGE_LOG_WORKER_CONCURRENCY=4

# On shutdown (SIGTERM/SIGINT, or app.close()), how long to wait for the
# queue to drain before giving up and logging how many events remain
# unpersisted, in milliseconds.
USAGE_LOG_SHUTDOWN_TIMEOUT_MS=5000

# --- Reserved for future steps (NOT implemented yet) ---
# These are documented here so the shape of future configuration is clear.
# Do not set real values yet; nothing in the codebase reads them.

# Request rate limiting configuration, used once rate limiting is implemented.
# RATE_LIMIT_MAX=

# External log drain / log level overrides for production observability.
# LOG_LEVEL=
