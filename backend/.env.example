# TokenGuard backend environment configuration
# Copy this file to .env and adjust values for your local setup.
# Do NOT commit a real .env file.

# --- Server (implemented in Step 1) ---

# Port the HTTP server listens on.
PORT=3000

# Host/interface the HTTP server binds to.
HOST=0.0.0.0

# Runtime environment: development | test | production
NODE_ENV=development

# --- Reserved for future steps (NOT implemented yet) ---
# These are documented here so the shape of future configuration is clear.
# Do not set real values yet; nothing in the codebase reads them.

# Supabase project URL, used for persistence and auth in a later step.
# SUPABASE_URL=

# Supabase service role key, used for privileged server-side access in a later step.
# SUPABASE_SERVICE_ROLE_KEY=

# OpenAI provider configuration, used once the AI proxy is implemented.
# OPENAI_API_BASE_URL=

# Anthropic provider configuration, used once the AI proxy is implemented.
# ANTHROPIC_API_BASE_URL=

# TokenGuard API key signing/hashing secret, used once API key auth is implemented.
# TOKENGUARD_API_KEY_SECRET=

# Request rate limiting configuration, used once rate limiting is implemented.
# RATE_LIMIT_MAX=

# External log drain / log level overrides for production observability.
# LOG_LEVEL=
